# Y Download - environment variables
#
# Copy to .env and fill in. NEVER commit .env (it is already gitignored).
# On Render, set these in the dashboard instead - not as a file.

# --- core -------------------------------------------------------------------
# Provider-injected; only set locally if you want a different port.
# PORT=8000
# YTDL_HOST=127.0.0.1

# Where finished/partial media is written. Use /tmp on ephemeral hosts.
# YTDL_MEDIA_DIR=/tmp/y-download

# Delete finished files after N seconds (default 600).
# YTDL_TTL_SECONDS=1800

# Wipe unknown leftover folders on start. Keep 0 locally so hand-downloaded
# files in ./downloads are never swept away.
# YTDL_SWEEP_ORPHANS=0

# --- abuse limits -----------------------------------------------------------
# YTDL_MAX_CONCURRENT_JOBS=3
# YTDL_RATE_LIMIT_JOBS=10
# YTDL_RATE_LIMIT_PREVIEWS=60
# Site-wide hourly ceiling shared by all clients (0 = disabled). A backstop for
# when the per-IP key cannot be trusted.
# YTDL_RATE_LIMIT_GLOBAL=0

# --- size / disk guards -----------------------------------------------------
# Largest JSON request body accepted (bytes).
# YTDL_MAX_REQUEST_BYTES=16384
# Largest single download (MB; 0 = unlimited).
# YTDL_MAX_FILESIZE_MB=2048
# Refuse new jobs when the media filesystem has less than this free (MB; 0 = off).
# YTDL_MIN_FREE_MB=512

# --- reverse proxy ----------------------------------------------------------
# How many proxy hops to trust when reading X-Forwarded-For. 1 is right for
# Render (its edge appends the real client IP). 0 ignores the header entirely.
# YTDL_TRUSTED_PROXY_HOPS=1
# Passed to gunicorn as forwarded_allow_ips (only affects scheme detection).
# YTDL_FORWARDED_ALLOW_IPS=*

# --- optional access control ------------------------------------------------
# If set, the whole site requires HTTP Basic auth.
#   username: YTDL_USERNAME (default "y-download")
#   password: YTDL_ACCESS_TOKEN
# Leave empty for a public instance.
# YTDL_ACCESS_TOKEN=
# YTDL_USERNAME=y-download
# Refuse to start in server mode without a token (default: warn only).
# YTDL_REQUIRE_AUTH=0
# Refuse to start if the SSRF redirect guard cannot be installed on yt-dlp's
# handlers (default: warn only). The curl_cffi impersonation path always fails
# closed regardless, by falling back to the guarded urllib handler.
# YTDL_REQUIRE_GUARD=0

# --- only if YouTube blocks the host's IP ------------------------------------
# Netscape-format cookie jar, base64 encoded:  base64 -w0 cookies.txt
# YTDL_COOKIES_B64=
# Or a path to a cookies.txt file mounted on the host.
# YTDL_COOKIES_FILE=/app/.cookies.txt
# Outbound proxy, e.g. http://user:pass@proxy.example.com:8080
# YTDL_PROXY=

# --- impersonation ----------------------------------------------------------
# Impersonate a real browser for yt-dlp's generic extractor, which works around
# the Cloudflare 403s many sites return to datacenter IPs. Requires curl-cffi
# (already in requirements.txt). Set to 0 to disable.
# YTDL_GENERIC_IMPERSONATE=1

# --- direct-to-device downloads ---------------------------------------------
# When 1, /info may hand the browser a direct media URL so eligible single-file
# sources are fetched straight from the CDN - nothing is stored on the server and
# the /file hop is skipped. Ineligible sources (anything needing a video+audio
# merge, HLS/DASH, or an MP3 transcode, e.g. YouTube) always use the server-side
# flow, exactly as before. Off by default.
# YTDL_DIRECT=0
