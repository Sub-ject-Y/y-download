# Y Download - environment variables
#
# Copy to .env and fill in. NEVER commit .env (it is already gitignored).
# On Render, set these in the dashboard instead - not as a file.

# --- core -------------------------------------------------------------------
# Provider-injected; only set locally if you want a different port.
# PORT=8000
# YTDL_HOST=127.0.0.1

# Where finished/partial media is written. Use /tmp on ephemeral hosts.
# YTDL_MEDIA_DIR=/tmp/y-download

# Delete finished files after N seconds (default 600).
# YTDL_TTL_SECONDS=1800

# Wipe unknown leftover folders on start. Keep 0 locally so hand-downloaded
# files in ./downloads are never swept away.
# YTDL_SWEEP_ORPHANS=0

# --- abuse limits -----------------------------------------------------------
# YTDL_MAX_CONCURRENT_JOBS=3
# YTDL_RATE_LIMIT_JOBS=10
# YTDL_RATE_LIMIT_PREVIEWS=60

# --- optional access control ------------------------------------------------
# If set, the whole site requires HTTP Basic auth.
#   username: YTDL_USERNAME (default "y-download")
#   password: YTDL_ACCESS_TOKEN
# Leave empty for a public instance.
# YTDL_ACCESS_TOKEN=
# YTDL_USERNAME=y-download

# --- only if YouTube blocks the host's IP ------------------------------------
# Netscape-format cookie jar, base64 encoded:  base64 -w0 cookies.txt
# YTDL_COOKIES_B64=
# Or a path to a cookies.txt file mounted on the host.
# YTDL_COOKIES_FILE=/app/.cookies.txt
# Outbound proxy, e.g. http://user:pass@proxy.example.com:8080
# YTDL_PROXY=
